{
 "comment": "Shared env matrix for the Ompig config root policy: OMPIG_HOME, else XDG_CONFIG_HOME/ompig, else ~/.ompig. Env values: absent = unset, \"\" = set and empty. <HOME> stands for the HOME (USERPROFILE on Windows) of the run; HOME \"\" makes the home directory unavailable. want null = resolution fails. Read by internal/configroot, the Go, Python and Rust SDK tests, the Node getter test and the cross-language comparison in test/extension-conformance. A tilde expansion and the XDG and default joins are lexically cleaned as Go's filepath.Join cleans them (repeated, trailing and . separators, name/..), and an absolute remainder after ~/ stays under the home directory; a literal OMPIG_HOME is never cleaned.",
 "cases": [
  {
   "name": "ompig-home-absolute",
   "env": {
    "OMPIG_HOME": "/srv/ompig"
   },
   "want": "/srv/ompig"
  },
  {
   "name": "ompig-home-beats-xdg",
   "env": {
    "OMPIG_HOME": "/srv/ompig",
    "XDG_CONFIG_HOME": "/srv/xdg"
   },
   "want": "/srv/ompig"
  },
  {
   "name": "ompig-home-empty-falls-to-xdg",
   "env": {
    "OMPIG_HOME": "",
    "XDG_CONFIG_HOME": "/srv/xdg"
   },
   "want": "/srv/xdg/ompig"
  },
  {
   "name": "ompig-home-unset-xdg-set",
   "env": {
    "XDG_CONFIG_HOME": "/srv/xdg"
   },
   "want": "/srv/xdg/ompig"
  },
  {
   "name": "both-empty-falls-to-home",
   "env": {
    "OMPIG_HOME": "",
    "XDG_CONFIG_HOME": ""
   },
   "want": "<HOME>/.ompig"
  },
  {
   "name": "both-unset-falls-to-home",
   "env": {},
   "want": "<HOME>/.ompig"
  },
  {
   "name": "ompig-home-empty-xdg-unset",
   "env": {
    "OMPIG_HOME": ""
   },
   "want": "<HOME>/.ompig"
  },
  {
   "name": "ompig-home-tilde",
   "env": {
    "OMPIG_HOME": "~"
   },
   "want": "<HOME>"
  },
  {
   "name": "ompig-home-tilde-slash",
   "env": {
    "OMPIG_HOME": "~/p"
   },
   "want": "<HOME>/p"
  },
  {
   "name": "ompig-home-tilde-user-literal",
   "env": {
    "OMPIG_HOME": "~user/p"
   },
   "want": "~user/p"
  },
  {
   "name": "ompig-home-tilde-inside-literal",
   "env": {
    "OMPIG_HOME": "a/~/b"
   },
   "want": "a/~/b"
  },
  {
   "name": "ompig-home-relative-literal",
   "env": {
    "OMPIG_HOME": "rel/ompig"
   },
   "want": "rel/ompig"
  },
  {
   "name": "ompig-home-dot-ompig-literal",
   "env": {
    "OMPIG_HOME": ".ompig"
   },
   "want": ".ompig"
  },
  {
   "name": "xdg-tilde-slash",
   "env": {
    "XDG_CONFIG_HOME": "~/cfg"
   },
   "want": "<HOME>/cfg/ompig"
  },
  {
   "name": "xdg-tilde",
   "env": {
    "XDG_CONFIG_HOME": "~"
   },
   "want": "<HOME>/ompig"
  },
  {
   "name": "xdg-relative-literal",
   "env": {
    "XDG_CONFIG_HOME": "rel"
   },
   "want": "rel/ompig"
  },
  {
   "name": "ompig-home-empty-xdg-tilde",
   "env": {
    "OMPIG_HOME": "",
    "XDG_CONFIG_HOME": "~/x"
   },
   "want": "<HOME>/x/ompig"
  },
  {
   "name": "home-failure-default",
   "env": {
    "HOME": ""
   },
   "want": null
  },
  {
   "name": "home-failure-ompig-home-tilde",
   "env": {
    "HOME": "",
    "OMPIG_HOME": "~/p"
   },
   "want": null
  },
  {
   "name": "home-failure-xdg-tilde",
   "env": {
    "HOME": "",
    "XDG_CONFIG_HOME": "~/c"
   },
   "want": null
  },
  {
   "name": "home-failure-empty-overrides",
   "env": {
    "HOME": "",
    "OMPIG_HOME": "",
    "XDG_CONFIG_HOME": ""
   },
   "want": null
  },
  {
   "name": "home-failure-literal-ompig-home-needs-no-home",
   "env": {
    "HOME": "",
    "OMPIG_HOME": "/srv/ompig"
   },
   "want": "/srv/ompig"
  },
  {
   "name": "home-failure-literal-xdg-needs-no-home",
   "env": {
    "HOME": "",
    "XDG_CONFIG_HOME": "/srv/xdg"
   },
   "want": "/srv/xdg/ompig"
  },
  {
   "name": "ompig-home-tilde-slash-only",
   "env": {
    "OMPIG_HOME": "~/"
   },
   "want": "<HOME>"
  },
  {
   "name": "ompig-home-tilde-trailing-slash",
   "env": {
    "OMPIG_HOME": "~/p/"
   },
   "want": "<HOME>/p"
  },
  {
   "name": "ompig-home-tilde-double-slash-stays-under-home",
   "env": {
    "OMPIG_HOME": "~//p/"
   },
   "want": "<HOME>/p"
  },
  {
   "name": "ompig-home-tilde-dotdot",
   "env": {
    "OMPIG_HOME": "~/a/./../p"
   },
   "want": "<HOME>/p"
  },
  {
   "name": "ompig-home-literal-not-cleaned",
   "env": {
    "OMPIG_HOME": "/srv//ompig/./"
   },
   "want": "/srv//ompig/./"
  },
  {
   "name": "xdg-trailing-slash",
   "env": {
    "XDG_CONFIG_HOME": "/srv/xdg/"
   },
   "want": "/srv/xdg/ompig"
  },
  {
   "name": "xdg-dotdot-and-double-slash",
   "env": {
    "XDG_CONFIG_HOME": "/srv//a/../xdg"
   },
   "want": "/srv/xdg/ompig"
  },
  {
   "name": "xdg-relative-dot",
   "env": {
    "XDG_CONFIG_HOME": "./rel/"
   },
   "want": "rel/ompig"
  },
  {
   "name": "gopi-home-is-not-read",
   "env": {
    "GOPI_HOME": "/srv/gopi"
   },
   "want": "<HOME>/.ompig"
  }
 ]
}
